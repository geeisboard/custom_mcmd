#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/* OLED on I2C2 (PB13=SCL, PB14=SDA) */
&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb11>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		prechargep = <0x22>;
		segment-remap;
		com-invdir;
	};
};

/* MIDI OUT (poly) - single-wire, TX only, PA9 */
&usart1 {
	status = "okay";
	current-speed = <31250>;
	pinctrl-0 = <&usart1_tx_pa9>;
	pinctrl-names = "default";
	single-wire;
};

/* MIDI OUT (master) - single-wire, TX only, PA2 */
&usart2 {
	status = "okay";
	current-speed = <31250>;
	pinctrl-0 = <&usart2_tx_pa2>;
	pinctrl-names = "default";
	single-wire;
};

/ {
	chosen {
		zephyr,display = &ssd1306;
		/* usart1 remains console/shell-uart from the base board dts
		 * unless you override it here. If you want NO console since
		 * usart1 is now MIDI-only, uncomment and repoint elsewhere
		 * (e.g. usart4, your debug UART):
		 */
		zephyr,console = &usart4;
		zephyr,shell-uart = &usart4;
	};

	aliases {
		midi-master-uart = &usart2;
		midi-poly-uart   = &usart1;
	};

	md_encoder: md-encoder {
        compatible = "digee,md-encoder";
        gpios = <&gpiod 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>, /* phase A */
                <&gpioa 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>, /* phase B */
				<&gpiod 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; /* SW */
    };

	buttons: buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpiob 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button 0";
			zephyr,code = <INPUT_KEY_0>;
		};
		button1: button_1 {
			gpios = <&gpiob 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button 1";
			zephyr,code = <INPUT_KEY_1>;
		};
		button2: button_2 {
			gpios = <&gpioa 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button 2";
			zephyr,code = <INPUT_KEY_2>;
		};
		button3: button_3 {
			gpios = <&gpioa 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button 3";
			zephyr,code = <INPUT_KEY_3>;
		};
	};
};
