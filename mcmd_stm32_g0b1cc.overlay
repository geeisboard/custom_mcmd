/*
 * Application overlay for mcmd_stm32_g0b1cc
 * Adapted from a previous STM32F401CC overlay.
 *
 * Changes from the F401 version:
 *  - Encoder switched from STM32 hardware timer QDEC (TIM3) to software
 *    gpio-qdec, since TIM3 CH1/CH2 aren't wired to the encoder on this
 *    board. SPI1 no longer needs to be disabled as a result (it was only
 *    disabled before to free PA6/PA7 for TIM3).
 *  - OLED moved from I2C1 (PB8/PB9) to I2C2 (PB13/PB14): PB9 is now a
 *    button pin, and PB7 (I2C1's other SDA option) is also a button pin,
 *    so I2C1 has no free SDA pin left. I2C2 doesn't collide with anything
 *    else on this board yet.
 *  - Button pins changed to PB7, PB9, PA4, PA5 per your new wiring.
 *  - Encoder switch moved to PD0 (was PB6 on the F401 board).
 */

#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/* OLED on I2C2 (PB13=SCL, PB14=SDA) */
&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_scl_pb13 &i2c2_sda_pb14>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		prechargep = <0x22>;
		segment-remap;
		com-invdir;
	};
};

/* MIDI OUT (master) - single-wire, TX only, PA9 */
&usart1 {
	status = "okay";
	current-speed = <31250>;
	pinctrl-0 = <&usart1_tx_pa9>;
	pinctrl-names = "default";
	single-wire;
};

/* MIDI OUT (poly) - single-wire, TX only, PA2 */
&usart2 {
	status = "okay";
	current-speed = <31250>;
	pinctrl-0 = <&usart2_tx_pa2>;
	pinctrl-names = "default";
	single-wire;
};

/ {
	chosen {
		zephyr,display = &ssd1306;
		/* usart1 remains console/shell-uart from the base board dts
		 * unless you override it here. If you want NO console since
		 * usart1 is now MIDI-only, uncomment and repoint elsewhere
		 * (e.g. usart4, your debug UART):
		 */
		/* zephyr,console = &usart4; */
		/* zephyr,shell-uart = &usart4; */
	};

	aliases {
		qdec0            = &encoder;
		midi-master-uart = &usart1;
		midi-poly-uart   = &usart2;
	};

	/* Rotary encoder - software GPIO qdec (no hardware timer needed) */
	encoder: qdec {
		compatible = "gpio-qdec";
		gpios = <&gpiod 1 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>,   /* ENC_A = PD1 */
			<&gpioa 15 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;  /* ENC_B = PA15 */
		steps-per-period = <4>;   /* adjust if your encoder isn't 4x/detent */
		zephyr,axis = <INPUT_REL_WHEEL>;
		sample-time-us = <2000>;
		idle-timeout-ms = <200>;
	};

	encodersw {
		compatible = "gpio-keys";

		encodersw0: encoder_sw0 {
			gpios = <&gpiod 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  /* SW = PD0 */
			label = "Encoder SW";
			zephyr,code = <INPUT_KEY_ENTER>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpiob 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button 0";
			zephyr,code = <INPUT_KEY_0>;
		};
		button1: button_1 {
			gpios = <&gpiob 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button 1";
			zephyr,code = <INPUT_KEY_1>;
		};
		button2: button_2 {
			gpios = <&gpioa 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button 2";
			zephyr,code = <INPUT_KEY_2>;
		};
		button3: button_3 {
			gpios = <&gpioa 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button 3";
			zephyr,code = <INPUT_KEY_3>;
		};
	};
};
